# Copy this file to .env and fill in the values. Never commit .env.

# Duffel TEST access token. Must start with duffel_test_ (the server refuses anything else).
DUFFEL_ACCESS_TOKEN=

# LiteAPI sandbox key. Starts with sand_.
LITEAPI_KEY=

# Optional. Only needed for the Case 3 experiment (Stripe).
STRIPE_SECRET_KEY=

# Port the Express server listens on.
PORT=3000
